# ── Core ──────────────────────────────────────────────
DATABASE_URL=               # Replit PostgreSQL URL (leave blank for SQLite)
JWT_SECRET=                 # REQUIRED — random 64-char string
APEX_ADMIN_EMAIL=you@email.com
APEX_ADMIN_PASSWORD=        # REQUIRED — admin password

# ── AI ────────────────────────────────────────────────
GEMINI_API_KEY=             # Google Gemini (free tier available)
OPENAI_API_KEY=             # OpenAI — optional, Gemini preferred

# ── Free Market Data APIs ──────────────────────────────
ALPHA_VANTAGE_API_KEY=      # https://www.alphavantage.co/support/#api-key (free)
FINNHUB_API_KEY=            # https://finnhub.io (free tier)
FMP_API_KEY=                # https://financialmodelingprep.com (free tier)
FRED_API_KEY=               # https://fred.stlouisfed.org/docs/api/api_key.html (free)

# ── SEC EDGAR (no key needed — just User-Agent) ────────
SEC_USER_AGENT_NAME=Advanced Trade Intelligence
SEC_USER_AGENT_EMAIL=you@email.com

# ── API Daily Budgets (safe defaults provided) ─────────
ALPHA_VANTAGE_DAILY_LIMIT=20
FMP_DAILY_LIMIT=200
FINNHUB_DAILY_LIMIT=500
FRED_DAILY_LIMIT=100

# ── Feature Flags ─────────────────────────────────────
ENABLE_YAHOO_FALLBACK=true

# ── Server ────────────────────────────────────────────
PORT=3001
CLIENT_PORT=5001
NODE_ENV=development
